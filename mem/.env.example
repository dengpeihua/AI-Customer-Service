# Local Mem0 overrides. Provider keys and model defaults are read from the root .env.
MINIMAX_EMBEDDING_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_EMBED_MODEL=embo-01
MEM0_EMBEDDING_PROVIDER=minimax
EMBEDDING_DIMS=1536
COLLECTION_NAME=memories_minimax_embo_01_1536

MEM0_HOST=http://127.0.0.1:8888
MEM0_BACKEND=oss
# Optional override; scripts/run_mem0.py pins the default to this checkout's mem/data.
# MEM0_DATA_DIR=/absolute/path/to/data
