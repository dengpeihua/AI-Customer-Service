# Local Mem0 + embedded benchmarks
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_EMBED_MODEL=text-embedding-v3
EMBEDDING_DIMS=1024
COLLECTION_NAME=mem0_local_1024

MEM0_HOST=http://127.0.0.1:8888
MEM0_BACKEND=oss
# Optional override; the default is /home/dengpeihua/mem/data
# MEM0_DATA_DIR=/absolute/path/to/data
