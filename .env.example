APP_ENV=dev
DATABASE_URL=sqlite+pysqlite:///./acs.db

# Replace these before real customer use.
JWT_SECRET=待填写
BOOTSTRAP_TOKEN=待填写

# Required when APP_ENV=prod. Generate a base64-encoded 32-byte key.
FIELD_ENC_KEY=待填写

# MiniMax M3 chat + MiniMax embedding。
LLM_PROVIDER=minimax
MINIMAX_API_KEY=待填写
MINIMAX_API_BASE=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_EMBEDDING_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_EMBED_MODEL=embo-01
MEM0_EMBEDDING_PROVIDER=minimax
LLM_EMBEDDING_DIMENSION=1536
EMBEDDING_DIMS=1536
COLLECTION_NAME=memories_minimax_embo_01_1536

# GLM 备用配置，保持注释即可继续使用 MiniMax。密钥只填写到本地 .env。
# 启用时替换已有 LLM_PROVIDER/LLM_EMBEDDING_DIMENSION，避免同名配置重复。
# GLM-4.7 不提供 embedding；向量化使用 embedding-3。
# LLM_PROVIDER=glm
# GLM_API_KEY=待填写
# GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4.7
# GLM_EMBED_MODEL=embedding-3
# LLM_EMBEDDING_DIMENSION=2048
# 启用前备份 acs.db 并重建知识库向量索引、重新校准检索阈值。详见 README。

# OpenAI Agents SDK Triage：保留多少条历史消息，以及单次最多允许多少次模型调用。
AGENT_HISTORY_LIMIT=12
AGENT_MAX_TURNS=4
DEEPSEEK_API_KEY=待填写
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=false
# 可选：切回 DeepSeek 时设置 LLM_PROVIDER=deepseek，并填写其密钥。

RAG_DISTANCE_CUTOFF=0.60

# Mem0 工作台长任务允许较长等待；在线聊天只把记忆当可选上下文，超时即快速降级。
MEM0_TIMEOUT_SECONDS=120
MEM0_CHAT_RECALL_TIMEOUT_SECONDS=1.5
ADMIN_COOKIE_SECURE=false
