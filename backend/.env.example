# 应用
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Anthropic 官方或兼容接口
ANTHROPIC_API_KEY=replace_with_your_api_key
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Redis
REDIS_PASSWORD=replace_with_a_strong_password
REDIS_URL=redis://:replace_with_a_strong_password@localhost:6379/0

# ChromaDB 与本地数据
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma
EVAL_BASELINE_PATH=./data/eval/baseline.json

# Skills
SALSO_SKILLS_DIR=./skills
SALSO_SKILLS_MAX_PROMPT_CHARS=5000

# 监控；0 表示不额外启动独立 Prometheus HTTP 端口
PROMETHEUS_PORT=0
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=

# 前端 Docker 直连端口
FRONTEND_PORT=5174
