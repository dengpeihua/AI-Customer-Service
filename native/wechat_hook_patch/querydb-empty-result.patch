+static bool is_readable_range(const void* address, size_t size) {
+	if (address == nullptr || size == 0) {
+		return false;
+	}
+	MEMORY_BASIC_INFORMATION mbi = {};
+	if (VirtualQuery(address, &mbi, sizeof(mbi)) != sizeof(mbi) ||
+		mbi.State != MEM_COMMIT ||
+		(mbi.Protect & (PAGE_GUARD | PAGE_NOACCESS)) != 0) {
+		return false;
+	}
+	const uintptr_t start = reinterpret_cast<uintptr_t>(address);
+	const uintptr_t region_start = reinterpret_cast<uintptr_t>(mbi.BaseAddress);
+	const uintptr_t region_end = region_start + mbi.RegionSize;
+	return start >= region_start && start <= region_end && size <= region_end - start;
+}
+
+static bool is_likely_database_handle(LPVOID candidate, size_t expected_vfs) {
+	if ((reinterpret_cast<uintptr_t>(candidate) & (alignof(void*) - 1)) != 0 ||
+		!is_readable_range(candidate, 0x38)) {
+		return false;
+	}
+	bool valid = false;
+	__try {
+		const BYTE* bytes = static_cast<const BYTE*>(candidate);
+		const uintptr_t actual_vfs = *reinterpret_cast<const uintptr_t*>(bytes);
+		const void* default_collation = *reinterpret_cast<void* const*>(bytes + 0x10);
+		const void* databases = *reinterpret_cast<void* const*>(bytes + 0x20);
+		const int database_count = *reinterpret_cast<const int*>(bytes + 0x28);
+		valid = actual_vfs == expected_vfs &&
+			database_count > 0 && database_count <= 64 &&
+			is_readable_range(default_collation, sizeof(void*)) &&
+			is_readable_range(databases, sizeof(void*));
+	}
+	__except (EXCEPTION_EXECUTE_HANDLER) {
+		valid = false;
+	}
+	return valid;
+}
+
+static bool try_get_database_path(sqlite3_api_routines* routines, sqlite3* db,
+	char* output, size_t output_size) {
+	if (routines == nullptr || db == nullptr || output == nullptr || output_size < 2) {
+		return false;
+	}
+	output[0] = '\0';
+	sqlite3_stmt* stmt = nullptr;
+	bool found = false;
+	bool faulted = false;
+	__try {
+		if (routines->prepare(db, "PRAGMA database_list", -1, &stmt, nullptr) == SQLITE_OK &&
+			stmt != nullptr) {
+			while (routines->step(stmt) == SQLITE_ROW) {
+				if (routines->column_count(stmt) < 3) {
+					continue;
+				}
+				const int length = routines->column_bytes(stmt, 2);
+				const unsigned char* text = routines->column_text(stmt, 2);
+				if (length <= 0 || static_cast<size_t>(length) >= output_size ||
+					!is_readable_range(text, static_cast<size_t>(length))) {
+					continue;
+				}
+				memcpy(output, text, static_cast<size_t>(length));
+				output[length] = '\0';
+				found = true;
+				break;
+			}
+		}
+	}
+	__except (EXCEPTION_EXECUTE_HANDLER) {
+		faulted = true;
+	}
+	if (stmt != nullptr) {
+		__try {
+			routines->finalize(stmt);
+		}
+		__except (EXCEPTION_EXECUTE_HANDLER) {
+			faulted = true;
+		}
+	}
+	return found && !faulted;
+}
